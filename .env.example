# ── SUPABASE (Postgres database) ────────────────────────────
# Pooled connection string used by the app (postgres.js). Required — the app
# throws if unset. Get it from: Supabase → Project → Connect → Transaction pooler.
DATABASE_URL=

# Project references (optional; for the dashboard / future supabase-js usage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=

# Service role key — FULL DB access, bypasses RLS. SECRET, server-only, never
# NEXT_PUBLIC_, never commit. From: Supabase → Settings → API Keys → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── ADMIN AUTH ──────────────────────────────────────────────
# Admin panel password (used at /admin login). Set the same value in Vercel.
ADMIN_PASSWORD=

# Secret that signs the admin session cookie (HMAC). Use a long random string,
# e.g. `openssl rand -hex 32`. Set the same value in Vercel.
AUTH_SECRET=

# ── AI CHATBOT ──────────────────────────────────────────────
GROQ_API_KEY=
