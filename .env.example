# Groq API Key for AI Chatbot
GROQ_API_KEY=

# Neon Postgres connection string (pooled). Required — the app throws if unset.
DATABASE_URL=

# Admin panel password. Choose a strong value. Set the same value in Vercel.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (HMAC). Use a long random string,
# e.g. `openssl rand -hex 32`. Set the same value in Vercel.
AUTH_SECRET=
